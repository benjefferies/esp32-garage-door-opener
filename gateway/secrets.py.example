# Copy to secrets.py on the gateway (never commit secrets.py).
# Wi-Fi is set via the garage-gw setup page and stored in wifi.json.
# HiveMQ Cloud Serverless: Cluster URL, port 8883, username + password.

MQTT_HOST = "6976bf6995e243d6be6c1f3634bb4f10.s1.eu.hivemq.cloud"
MQTT_PORT = 8883
MQTT_USER = "gateway"
MQTT_PASSWORD = "your-hivemq-password"
MQTT_CLIENT_ID = "garage-gateway"

# Optional override for the Saved-page redirect
APP_URL = "https://garage-opener-rose.vercel.app"

# Required for live door status and pairing confirm. HiveMQ Cloud cannot
# POST to Convex, so the gateway calls these HTTP routes itself.
CONVEX_SITE_URL = "https://marvelous-herring-626.eu-west-1.convex.site"
DOOR_WEBHOOK_SECRET = "same-as-convex-DOOR_WEBHOOK_SECRET"
